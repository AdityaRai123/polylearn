# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=polylearn_jwt_secret_key_change_me_in_production

# Frontend origin(s) allowed by CORS, comma-separated (leave empty to allow any origin)
CLIENT_URL=http://localhost:5173

# Code a person must enter to sign up as a teacher. Leave empty to disable teacher sign-up.
TEACHER_INVITE_CODE=

# Database: either a connection string for a hosted database (Postgres or MySQL)...
# DATABASE_URL=postgres://user:password@host:5432/polylearn
# DB_SSL=true

# ...or a local MySQL server
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=polylearn

# ...or a local SQLite file (server/database.sqlite)
# DB_DIALECT=sqlite

# Frontend Configuration
VITE_API_URL=http://localhost:5000
